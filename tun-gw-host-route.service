[Unit]
Description=Reapply tun-gw host-side traffic routing rules
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/xray-tun-gateway/host-gateway.sh reapply
ExecStop=/opt/xray-tun-gateway/host-gateway.sh disable

[Install]
WantedBy=multi-user.target
