# tun-gw 配置(单容器版) — 不含密钥(真正的敏感信息在 config/xray/config.json 里)

XRAY_BASE_IMAGE=ghcr.io/xtls/xray-core:26.10.10
GW_IMAGE_TAG=tun-gw-xray:local
TEST_IMAGE=docker.io/nicolaka/netshoot:latest

NETWORK_NAME=tun-gw-network
GW_NAME=tun-gw-xray
TEST_B_NAME=tun-gw-test-b
TEST_C_NAME=tun-gw-test-c

# docker / podman 各用独立网段,可同时共存
DOCKER_SUBNET=10.90.0.0/24
DOCKER_GW_IP=10.90.0.2

PODMAN_SUBNET=10.91.0.0/24
PODMAN_GW_IP=10.91.0.2
